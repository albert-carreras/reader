# reader — web app + background renderer, one process, on 127.0.0.1:8130.
# systemd *user* service: ./stack install copies it to ~/.config/systemd/user/ (linger is enabled).
[Unit]
Description=reader — read-along audiobooks (web app + renderer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/reader
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONWARNINGS=ignore
# READER_ACCESS_TEAM / READER_ACCESS_AUD / READER_THREADS / READER_NICE live here (not committed)
EnvironmentFile=-%h/.config/reader/env
ExecStart=%h/.local/bin/uv run --no-sync python -m reader.server
Restart=always
RestartSec=5
# rendering is background work: keep the laptop responsive
Nice=5
CPUWeight=50
# never take the machine down (2026-11-27 it ran out of memory and froze): past 7 GB only this service is killed
# (and restarts in seconds). Almost no swap: thrashing is what froze it. No MemoryHigh: throttling this service
# stalls the web server with it, and the app stops loading (also 2026-11-27); the renderer keeps well below the
# limit by itself (render lanes only start with headroom under it).
MemoryMax=7G
MemorySwapMax=256M
# when the limit is hit the kernel stops a voice process (they volunteer: oom_score_adj 1000); keep the service
# running (systemd would otherwise stop all of it, and the app with it), the renderer replaces the process
OOMPolicy=continue

[Install]
WantedBy=default.target
