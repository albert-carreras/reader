# reader — web app + background renderer, one process, on 127.0.0.1:8130.
# systemd *user* service: ./stack install copies it to ~/.config/systemd/user/ (linger is enabled).
[Unit]
Description=reader — read-along audiobooks (web app + renderer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/reader
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONWARNINGS=ignore
# READER_ACCESS_TEAM / READER_ACCESS_AUD / READER_THREADS / READER_NICE live here (not committed)
EnvironmentFile=-%h/.config/reader/env
ExecStart=%h/.local/bin/uv run --no-sync python -m reader.server
Restart=always
RestartSec=5
# rendering is background work: keep the laptop responsive
Nice=5
CPUWeight=50
# never take the machine down (2026-11-27 it ran out of memory and froze): past 6 GB the kernel reclaims from this
# service first; past 7 GB only this service is killed (and restarts). Almost no swap: thrashing is what froze it.
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=256M

[Install]
WantedBy=default.target
